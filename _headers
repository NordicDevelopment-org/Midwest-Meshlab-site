# ============================================================
# Cloudflare Pages security headers for midwestmeshlab.net
# Cloudflare serves this file automatically (do NOT rename).
#
# NOTE on CSP: this single-file build keeps CSS + JS inline so the
# page previews and edits as one file. That requires 'unsafe-inline'.
# Inline *style* is low risk; inline *script* is the thing to watch —
# since there are no third-party trackers and the site is static, the
# real exposure is small. To go strict ('self' only, no 'unsafe-inline'),
# split CSS/JS into external files and hash or nonce them — see ADMIN.md.
#
# Allowlisted origins, one purpose each:
#   fonts.googleapis.com / fonts.gstatic.com -> Google Fonts (self-host to drop; ADMIN.md)
#   api.open-meteo.com                        -> weather ticker (keyless, no cookies)
#   www.youtube-nocookie.com                  -> click-to-load video embeds
#   giscus.app                                -> community discussion (loads only on click)
#   buttondown.email                          -> newsletter form POST (swap if you change providers)
# ============================================================

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://buttondown.email; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://giscus.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.open-meteo.com; frame-src https://www.youtube-nocookie.com https://giscus.app; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

/events.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=900
